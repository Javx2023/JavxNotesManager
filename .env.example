# ============================
# JavxNotesManager - Variables de entorno
# ============================

# Ruta en el HOST donde están tus notas markdown
# El contenedor montará esta carpeta en /data/notas
# Ejemplos:
#   Linux/Mac:   /home/usuario/Documentos/Notas
#   Windows:     C:\Users\usuario\Documents\Notas
HOST_NOTAS_DIR=/home/usuario/Documentos/Notas

# Configuración del servidor Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
